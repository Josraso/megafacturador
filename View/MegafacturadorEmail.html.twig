{% extends "Master/MenuTemplate.html.twig" %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header">
                    <i class="fas fa-envelope fa-fw"></i> Enviar Emails - MegaFacturador
                </div>
                <div class="card-body">
                    {% if fsc.totalFacturas > 0 %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Se han generado <strong>{{ fsc.totalFacturas }}</strong> facturas pendientes de enviar por email.
                        </div>

                        <div class="text-center mt-4">
                            <a href="{{ fsc.url() }}?enviar=TRUE&runid={{ app.request.get('runid') }}" class="btn btn-primary btn-lg">
                                <i class="fas fa-paper-plane"></i> Enviar todas las facturas por email
                            </a>
                        </div>

                        <div class="text-center mt-3">
                            <a href="index.php?page=Megafacturador" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    {% else %}
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            No hay facturas pendientes de enviar.
                        </div>

                        <div class="text-center mt-3">
                            <a href="index.php?page=Megafacturador" class="btn btn-primary">
                                <i class="fas fa-arrow-left"></i> Volver al MegaFacturador
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
